# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Build artifacts — regenerable from the game's sts2.dll / .pck
decompiled/
pck_extracted/
*.sln

# Training / visualization outputs — reproducible via scripts/train_mvp.py
runs/

# Tools — most are downloaded/cloned; keep only the local wrapper script,
# the bit-exact PRNG oracle project, and its committed test vectors.
tools/*
!tools/ilspy
!tools/RngOracle/
tools/RngOracle/bin/
tools/RngOracle/obj/

# STS2MCP mod: source tree is .gitignored (external repo), but our
# small patches and the build-deploy README live in STS2MCP-bin/
# alongside the downloaded binary. Track only the .cs.new / .patch /
# README files there, never the .dll / .pdb / .json from the release.
!tools/STS2MCP-bin/
tools/STS2MCP-bin/*.dll
tools/STS2MCP-bin/*.pdb
tools/STS2MCP-bin/*.json
