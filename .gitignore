# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Build artifacts — regenerable from the game's sts2.dll / .pck
decompiled/
pck_extracted/
*.sln

# Training / visualization outputs — reproducible via scripts/train_mvp.py
runs/

# Tools — most are downloaded/cloned; keep only the local wrapper script,
# the bit-exact PRNG oracle project, and its committed test vectors.
tools/*
!tools/ilspy
!tools/RngOracle/
tools/RngOracle/bin/
tools/RngOracle/obj/

# STS2MCP mod: upstream source tree is .gitignored (external repo).
# Files we author or modify live in tools/STS2MCP-bin/mod_overlay/ as
# drop-in replacements; users copy them into their STS2MCP clone and
# run `dotnet build`. The trained ONNX policy + deploy README also live
# in tools/STS2MCP-bin/. Do NOT track the upstream binaries (.dll,
# .pdb, .json from the release) — they are reproducible from source.
!tools/STS2MCP-bin/
tools/STS2MCP-bin/*.dll
tools/STS2MCP-bin/*.pdb
tools/STS2MCP-bin/*.json
