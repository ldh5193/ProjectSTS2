# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Build artifacts — regenerable from the game's sts2.dll / .pck
decompiled/
pck_extracted/
*.sln

# Training / visualization outputs — reproducible via scripts/train_mvp.py
runs/

# RL training checkpoints — each sweep writes ~450 KB zips that grow
# unbounded across runs. The only weight the repo actually needs is
# tools/STS2MCP-bin/policy.onnx (the ONNX export of the most recent
# best checkpoint, ~110 KB). Re-export with scripts/export_onnx.py
# when a new sweep produces a better model.
models/

# Tools — most are downloaded/cloned; keep only the local wrapper script,
# the bit-exact PRNG oracle project, and its committed test vectors.
tools/*
!tools/ilspy
!tools/RngOracle/
tools/RngOracle/bin/
tools/RngOracle/obj/

# STS2MCP mod: upstream source tree is .gitignored (external repo).
# Files we author or modify live in tools/STS2MCP-bin/mod_overlay/ as
# drop-in replacements; users copy them into their STS2MCP clone and
# run `dotnet build`. The trained ONNX policy + deploy README also live
# in tools/STS2MCP-bin/. Do NOT track the upstream binaries (.dll,
# .pdb, .json from the release) — they are reproducible from source.
!tools/STS2MCP-bin/
tools/STS2MCP-bin/*.dll
tools/STS2MCP-bin/*.pdb
tools/STS2MCP-bin/*.json
# dotnet build artifacts inside the overlay sandbox — regenerated by every build.
tools/STS2MCP-bin/mod_overlay/obj/
tools/STS2MCP-bin/mod_overlay/bin/
# card_features.json is *our* derived lookup (from sim/card_catalog.py),
# not an upstream binary — keep it tracked so the deploy bundle stays
# reproducible from a single git checkout.
!tools/STS2MCP-bin/card_features.json

# Claude Code per-project state (cache, slash commands the user created locally).
.claude/
